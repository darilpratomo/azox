<div class="shell">
  <Nav current="templates" />

  <div class="container" style="padding-block: 3rem 1rem">
    <div class="narrow">
      <h1 class="rise-in">Templates</h1>
      <p class="lede rise-in delay-1">
        Complete, working sites. Copy any file with the button on its header,
        or download it. Each one is plain Azox with no dependencies beyond the
        framework itself.
      </p>
    </div>
  </div>

  <section class="section container reveal" style="padding-top:1rem">
    <p class="section-lede">
      All four assume a project made with
      <code>npx azoxjs create my-app</code>. Drop the files in and run
      <code>npm run dev</code>.
    </p>

    <div class="grid">
