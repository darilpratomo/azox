      <div class="card template-card">
        <div class="template-preview">
          <div class="wire">
            <div class="wire-row"><i class="accent"></i><i></i><i></i></div>
            <i class="tall"></i>
            <div class="wire-row"><i></i><i></i><i></i></div>
