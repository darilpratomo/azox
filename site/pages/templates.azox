      </div>

      <div class="card template-card">
        <div class="template-preview">
          <div class="wire">
            <i class="accent half"></i>
            <i></i>
            <i class="third"></i>
            <i></i>
            <i class="half"></i>
          </div>
        </div>
        <div class="template-body">
          <h3>Blog</h3>
          <p>An index page and a post page, showing nested routing.</p>
          <a class="card-more" href="#blog">Jump to code →</a>
