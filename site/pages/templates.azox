          <a class="card-more" href="#landing">Jump to code →</a>
        </div>
      </div>

      <div class="card template-card">
        <div class="template-preview">
          <div class="wire">
            <i class="accent third"></i>
            <i class="half"></i>
            <div class="wire-row"><i class="tall"></i><i class="tall"></i><i class="tall"></i></div>
          </div>
        </div>
        <div class="template-body">
          <h3>Portfolio</h3>
          <p>An intro and a project list built from a reusable card.</p>
          <a class="card-more" href="#portfolio">Jump to code →</a>
