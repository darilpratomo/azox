<head>
  <!-- Shared defaults. A page overriding og:title or og:description in
       its own <head> replaces these rather than adding a second copy. -->
  <link rel="canonical" href="https://azox.dev" />
  <meta property="og:site_name" content="Azox" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Azox — The Sound of Future Web" />
  <meta property="og:description" content="A web framework built from scratch. No Virtual DOM, no diffing, no runtime dependencies." />
  <meta property="og:image" content="https://azox.dev/og.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preload" href="/fonts/sora-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/style.css" />
  <script src="/site.js" defer></script>
  <script src="/search.js" defer></script>
</head>

<script>
  // The version is read from the framework's own package.json, so it
  // can never drift from what npm publishes — it used to be passed in
  // as a prop by all sixteen pages, each with the number written out.
  import pkg from '../../package.json' with { type: 'json' };

  // `current` marks the active link, and is still the page's business.
  const { current } = props();
</script>

<nav class="nav" data-nav>
  <div class="container nav-inner">
    <a class="brand" href="/">
      <span class="brand-mark">Azox</span>
      <span class="brand-version">v{pkg.version}</span>
    </a>

    <button class="nav-search" type="button" aria-label="Search documentation" data-search-open>
      <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-3.5-3.5" stroke-linecap="round" />
      </svg>
      <span class="nav-search-label">Search</span>
      <kbd class="nav-search-key">/</kbd>
    </button>

    <!-- Shown only below the desktop breakpoint. The links used to
         scroll sideways off the screen with nothing to open them. -->
    <button
      class="nav-toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="nav-menu"
      data-nav-toggle
    >
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
      <span class="nav-toggle-bar"></span>
    </button>

    <div class="nav-links" id="nav-menu" data-nav-menu>
      <a href="/docs" class={current === 'docs' ? 'is-active' : ''}>Docs</a>
      <a href="/learn" class={current === 'learn' ? 'is-active' : ''}>Tutorial</a>
      <a href="/templates" class={current === 'templates' ? 'is-active' : ''}>Templates</a>
      <a href="/playground" class={current === 'playground' ? 'is-active' : ''}>Playground</a>
      <a href="/why" class={current === 'why' ? 'is-active' : ''}>Why</a>
      <a href="https://github.com/darilpratomo/azox">GitHub</a>
    </div>
  </div>
</nav>

<!-- One dialog, rendered on every page by this component, so search
     works from anywhere rather than only inside the docs. -->
<div class="search" data-search data-open="false" role="dialog" aria-modal="true" aria-label="Search documentation">
  <div class="search-panel">
    <div class="search-field">
      <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-3.5-3.5" stroke-linecap="round" />
      </svg>
      <input
        type="search"
        placeholder="Search the documentation"
        autocomplete="off"
        spellcheck="false"
        aria-label="Search documentation"
        data-search-input
      />
      <kbd>esc</kbd>
    </div>

    <p class="search-status" data-search-status>Type to search the documentation.</p>
    <ul class="search-results" data-search-results></ul>
  </div>
</div>
