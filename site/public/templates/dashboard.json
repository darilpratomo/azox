{
  "name": "Dashboard",
  "component": "<script>\n  const { label, value } = props();\n</script>\n\n<div class=\"tile\">\n  <p class=\"tile-label\">{label}</p>\n  <p class=\"tile-value\">{value}</p>\n</div>",
  "page": "<script>\n  import Tile from './Card.azox';\n  import { signal, computed, onMount, onCleanup } from 'azox/reactivity';\n\n  const visitors = signal(1240);\n  const signups = signal(86);\n  const live = signal(true);\n\n  const rate = computed(() => ((signups() / visitors()) * 100).toFixed(1) + '%');\n\n  // A ticking number, cleaned up when the page goes away.\n  onMount(() => {\n    const timer = setInterval(() => {\n      if (!live()) return;\n      visitors.set(visitors() + Math.floor(Math.random() * 5));\n      if (Math.random() > 0.7) signups.set(signups() + 1);\n    }, 900);\n\n    return () => clearInterval(timer);\n  });\n</script>\n\n<main>\n  <h1>Today</h1>\n\n  <label>\n    <input type=\"checkbox\" bind:checked={live} />\n    Live updates\n  </label>\n\n  <section class=\"grid\">\n    <Tile label=\"Visitors\" value={visitors()} />\n    <Tile label=\"Sign-ups\" value={signups()} />\n    <Tile label=\"Conversion\" value={rate()} />\n  </section>\n</main>"
}
