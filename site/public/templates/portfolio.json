{
  "name": "Portfolio",
  "component": "<script>\n  const { title, body } = props();\n</script>\n\n<article class=\"card\">\n  <h2>{title}</h2>\n  <p>{body}</p>\n</article>",
  "page": "<script>\n  import Card from './Card.azox';\n  import { signal } from 'azox/reactivity';\n\n  const projects = signal([\n    { id: 1, title: 'Atlas', body: 'A mapping tool for field surveys.', tag: 'work' },\n    { id: 2, title: 'Ember', body: 'A small static site generator.', tag: 'side' },\n    { id: 3, title: 'Quill', body: 'Notes that sync over a local network.', tag: 'side' },\n  ]);\n\n  const filter = signal('all');\n\n  const shown = () =>\n    filter() === 'all' ? projects() : projects().filter((p) => p.tag === filter());\n</script>\n\n<main>\n  <h1>Ada Lovelace</h1>\n  <p class=\"lede\">Engineer. These are the things I have built.</p>\n\n  <nav class=\"filters\">\n    <each item={['all', 'work', 'side']} as=\"tag\">\n      <button on:click={() => filter.set(tag)}>{tag}</button>\n    </each>\n  </nav>\n\n  <section class=\"grid\">\n    <each item={shown()} as=\"project\" key={project.id}>\n      <Card title={project.title} body={project.body} />\n    </each>\n  </section>\n</main>"
}
