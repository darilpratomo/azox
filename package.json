{
  "name": "azoxjs",
  "version": "1.3.0",
  "description": "Azox Framework — The Sound of Future Web",
  "type": "module",
  "license": "MIT",
  "author": "Daril Pratomo <darilprtmsr@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darilpratomo/azox.git"
  },
  "homepage": "https://azox.dev",
  "bugs": {
    "url": "https://github.com/darilpratomo/azox/issues"
  },
  "bin": {
    "azox": "bin/azox.js"
  },
  "exports": {
    ".": {
      "types": "./core/index.d.ts",
      "default": "./core/index.js"
    },
    "./reactivity": {
      "types": "./core/reactivity/signal.d.ts",
      "default": "./core/reactivity/signal.js"
    },
    "./compiler": {
      "types": "./core/compiler/index.d.ts",
      "default": "./core/compiler/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "core",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "build": "node ./bin/azox.js compile"
  },
  "keywords": [
    "azox",
    "framework",
    "signals",
    "reactivity",
    "compiler",
    "ssr",
    "no-virtual-dom"
  ],
  "types": "./core/index.d.ts"
}
